DISCORD_TOKEN=
# Optional: restrict slash-command registration to one guild for instant updates.
DISCORD_GUILD_ID=
# Optional: category channel for newly opened tickets.
TICKET_CATEGORY_ID=
# Optional: category channel for closed tickets.
CLOSED_CATEGORY_ID=
# Optional: role allowed to manage tickets. Server administrators always qualify.
SUPPORT_ROLE_ID=
# Optional: channel for ticket audit logs and transcript files.
TICKET_LOG_CHANNEL_ID=
# Optional: maximum open tickets per member. Defaults to 3.
MAX_TICKETS_PER_USER=3
# Optional: auto-close inactive tickets after this many hours. 0 disables it.
AUTO_CLOSE_HOURS=0
BOTLY_PREFIX=!
